---
import { Sidenav } from "@components";
import "../styles/global.css";
import type { NavLocation } from "@lib/nav";
import { MobileNav } from "../components/Sidenav";

interface LayoutProps {
  location: NavLocation
};

const {location} = Astro.props as LayoutProps;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <link rel="icon" href="/avatar.svg">
  <title>Will Migdol</title>
</head>
<body>
  <Sidenav
    location={location}
  />
  <MobileNav client:load/>
  <main>
    <slot/>
  </main>
</body>
</html>