{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
    	"@components": ["./src/components"],
    	"@components/*": ["./src/components/*"],
      "@data/*": ["./src/data/*"],
      "@globals": ["./src/globals.d.ts"],
      "@lib/*": ["./src/lib/*"],
      "@layout": ["./src/layouts/layout.astro"]
    },
    "strictNullChecks": true,
    "allowJs": true
  },
}
